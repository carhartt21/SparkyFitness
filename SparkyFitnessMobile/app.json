{
  "expo": {
    "name": "X on Track",
    "slug": "personalbest",
    "owner": "ilmtech",
    "scheme": "sparkyfitnessmobile",
    "orientation": "portrait",
    "icon": "./assets/icons/x-on-track-app-icon.png",
    "userInterfaceStyle": "automatic",
    "plugins": [
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "X on Track reads Health data (such as activity, workouts, and body measurements) to display it in the app and sync it to your self-hosted X on Track server.",
          "NSHealthUpdateUsageDescription": "X on Track writes the nutrition and hydration you log in the app to Apple Health, keeping the two in sync.",
          "background": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 26
          }
        }
      ],
      "react-native-health-connect",
      "expo-web-browser",
      "expo-font",
      "expo-asset",
      "expo-background-task",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "X on Track needs access to your camera to photograph meals and scan food barcodes and labels.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFBF3",
          "imageWidth": 200,
          "image": "./assets/brand/x-on-track-light.png",
          "dark": {
            "backgroundColor": "#24282D",
            "image": "./assets/brand/x-on-track-dark.png"
          }
        }
      ],
      ["expo-notifications"],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      ["@bacons/apple-targets"]
    ],
    "experiments": {
      "reactCompiler": true,
      "autolinkingModuleResolution": true
    },
    "extra": {
      "eas": {
        "projectId": "d0d1c7d2-deb1-4675-9411-2a1bd0a3a967"
      },
      "APP_VARIANT": "production"
    },
    "version": "1.7.2"
  }
}
