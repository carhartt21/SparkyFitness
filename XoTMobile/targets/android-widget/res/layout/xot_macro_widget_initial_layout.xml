<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/widget_surface"
    android:padding="14dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="20dp" android:layout_height="20dp"
            android:layout_marginEnd="6dp" android:src="@drawable/ic_widget_brand_x"
            android:importantForAccessibility="no" />
    <TextView
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:text="@string/widget_preview_macros_left"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/xot_widget_foreground"
        android:maxLines="1" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:text="" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@color/xot_widget_protein"
            android:text="" />

        <TextView
            android:layout_width="8dp"
            android:layout_height="1dp"
            android:text="" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_protein"
            android:textSize="14sp"
            android:textColor="@color/xot_widget_foreground"
            android:maxLines="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_grams_protein"
            android:textSize="14sp"
            android:textColor="@color/xot_widget_foreground"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:orientation="horizontal"
        android:background="@color/xot_widget_track">

        <TextView
            android:layout_width="72dp"
            android:layout_height="match_parent"
            android:background="@color/xot_widget_protein"
            android:text="" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:text="" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@color/xot_widget_carbs"
            android:text="" />

        <TextView
            android:layout_width="8dp"
            android:layout_height="1dp"
            android:text="" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_carbs"
            android:textSize="14sp"
            android:textColor="@color/xot_widget_foreground"
            android:maxLines="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_grams_carbs"
            android:textSize="14sp"
            android:textColor="@color/xot_widget_foreground"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:orientation="horizontal"
        android:background="@color/xot_widget_track">

        <TextView
            android:layout_width="154dp"
            android:layout_height="match_parent"
            android:background="@color/xot_widget_carbs"
            android:text="" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:text="" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@color/xot_widget_fat"
            android:text="" />

        <TextView
            android:layout_width="8dp"
            android:layout_height="1dp"
            android:text="" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_fat"
            android:textSize="14sp"
            android:textColor="@color/xot_widget_foreground"
            android:maxLines="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_grams_fat"
            android:textSize="14sp"
            android:textColor="@color/xot_widget_foreground"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:orientation="horizontal"
        android:background="@color/xot_widget_track">

        <TextView
            android:layout_width="78dp"
            android:layout_height="match_parent"
            android:background="@color/xot_widget_fat"
            android:text="" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:text="" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center">

        <ImageView
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:src="@drawable/ic_widget_search"
            android:tint="@color/xot_widget_energy"
            android:contentDescription="@string/widget_search_food" />

        <TextView
            android:layout_width="1dp"
            android:layout_height="48dp"
            android:background="@color/xot_widget_track"
            android:text="" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:src="@drawable/ic_widget_scan"
            android:tint="@color/xot_widget_energy"
            android:contentDescription="@string/widget_scan_barcode" />
    </LinearLayout>
</LinearLayout>
