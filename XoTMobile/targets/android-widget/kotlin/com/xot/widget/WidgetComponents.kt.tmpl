package com.sparkyapps.sparkyfitness.widget

import android.content.Intent
import androidx.compose.runtime.Composable
import androidx.compose.ui.unit.dp
import androidx.compose.ui.unit.sp
import androidx.glance.ColorFilter
import androidx.glance.GlanceModifier
import androidx.glance.Image
import androidx.glance.ImageProvider
import androidx.glance.action.clickable
import androidx.glance.appwidget.action.actionStartActivity
import androidx.glance.background
import androidx.glance.layout.Alignment
import androidx.glance.layout.Box
import androidx.glance.layout.Row
import androidx.glance.layout.Spacer
import androidx.glance.layout.fillMaxWidth
import androidx.glance.layout.height
import androidx.glance.layout.size
import androidx.glance.layout.width
import androidx.glance.text.FontWeight
import androidx.glance.text.Text
import androidx.glance.text.TextStyle
import {{APPLICATION_ID}}.R

@Composable
internal fun WidgetHeader(text: String) {
    Row(modifier = GlanceModifier.fillMaxWidth(), verticalAlignment = Alignment.CenterVertically) {
        Image(provider = ImageProvider(R.drawable.ic_widget_brand_x), contentDescription = null,
            modifier = GlanceModifier.size(20.dp))
        Spacer(modifier = GlanceModifier.width(6.dp))
        Text(text = text, maxLines = 1, modifier = GlanceModifier.defaultWeight(),
            style = TextStyle(color = WidgetPalette.foreground, fontSize = 16.sp, fontWeight = FontWeight.Bold))
    }
}

@Composable
internal fun WidgetActionButton(intent: Intent, icon: Int, contentDescription: String,
    modifier: GlanceModifier) {
    Box(modifier = modifier.height(48.dp)
        .background(ImageProvider(R.drawable.widget_action_background))
        .clickable(actionStartActivity(intent)), contentAlignment = Alignment.Center) {
        Image(provider = ImageProvider(icon), contentDescription = contentDescription,
            colorFilter = ColorFilter.tint(WidgetPalette.accent), modifier = GlanceModifier.size(24.dp))
    }
}
