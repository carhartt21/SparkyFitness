package com.sparkyapps.sparkyfitness.widget

import android.content.Context
import android.content.Intent
import android.net.Uri
import android.os.Build
import androidx.compose.runtime.Composable
import androidx.compose.ui.unit.dp
import androidx.datastore.preferences.core.Preferences
import androidx.datastore.preferences.core.stringPreferencesKey
import androidx.glance.GlanceId
import androidx.glance.GlanceModifier
import androidx.glance.GlanceTheme
import androidx.glance.ImageProvider
import androidx.glance.action.clickable
import androidx.glance.appwidget.GlanceAppWidget
import androidx.glance.appwidget.action.actionStartActivity
import androidx.glance.appwidget.LinearProgressIndicator
import androidx.glance.appwidget.cornerRadius
import androidx.glance.appwidget.provideContent
import androidx.glance.background
import androidx.glance.currentState
import androidx.glance.layout.Alignment
import androidx.glance.layout.Box
import androidx.glance.layout.Column
import androidx.glance.layout.Row
import androidx.glance.layout.Spacer
import androidx.glance.layout.fillMaxSize
import androidx.glance.layout.fillMaxWidth
import androidx.glance.layout.height
import androidx.glance.layout.padding
import androidx.glance.layout.width
import androidx.glance.state.PreferencesGlanceStateDefinition
import {{APPLICATION_ID}}.R
import java.time.LocalDate
import java.time.format.DateTimeFormatter
import org.json.JSONObject

/** Nutrition values retain their snapshot semantics; the X is static brand artwork. */
class CalorieWidget : GlanceAppWidget() {

    override val stateDefinition = PreferencesGlanceStateDefinition

    override suspend fun provideGlance(context: Context, id: GlanceId) {
        val fallbackSnapshot = loadSnapshot(context)
        provideContent {
            GlanceTheme {
                WidgetContent(context = context, fallbackSnapshot = fallbackSnapshot)
            }
        }
    }

    @Composable
    private fun WidgetContent(context: Context, fallbackSnapshot: CalorieSnapshot?) {
        val state = currentState<Preferences>()
        // Observe the dedicated revision so an active Glance session recomposes
        // after a language-only invalidation.
        currentState(WidgetLocale.LOCALE_RENDER_REVISION_STATE_KEY)
        val snapshot = parseSnapshot(state[SNAPSHOT_STATE_KEY]) ?: fallbackSnapshot

        // Widget-only locale override: localized string and number resolution
        // stay local to widget rendering (see WidgetLocale).
        val widgetContext = WidgetLocale.localizedContext(context)

        val remainingText: String
        val progress: Float
        if (snapshot == null) {
            remainingText = widgetContext.getString(R.string.widget_kcal_left_empty)
            progress = 0f
        } else {
            remainingText = widgetContext.getString(
                R.string.widget_kcal_left,
                formatInt(widgetContext, snapshot.remaining),
            )
            progress = snapshot.progress.coerceIn(0.0, 1.0).toFloat()
        }

        val openAppIntent = Intent(Intent.ACTION_VIEW, Uri.parse("sparkyfitnessmobile://"))
            .setPackage(context.packageName)
        val searchIntent = Intent(Intent.ACTION_VIEW, Uri.parse("sparkyfitnessmobile://search"))
            .setPackage(context.packageName)
        val scanIntent = Intent(Intent.ACTION_VIEW, Uri.parse("sparkyfitnessmobile://scan"))
            .setPackage(context.packageName)
        val searchFoodLabel = widgetContext.getString(R.string.widget_search_food)
        val scanBarcodeLabel = widgetContext.getString(R.string.widget_scan_barcode)

        Box(
            modifier = GlanceModifier
                .fillMaxSize()
                .background(ImageProvider(R.drawable.widget_surface))
                .appWidgetBackgroundCornerRadius()
                .padding(8.dp)
                .clickable(actionStartActivity(openAppIntent)),
        ) {
            Column(modifier = GlanceModifier.fillMaxSize()) {
                WidgetHeader(text = remainingText)
                Spacer(modifier = GlanceModifier.height(4.dp))
                LinearProgressIndicator(
                    progress = progress,
                    modifier = GlanceModifier
                        .fillMaxWidth()
                        .height(4.dp),
                    color = WidgetPalette.energy,
                    backgroundColor = WidgetPalette.track,
                )
                Spacer(modifier = GlanceModifier.defaultWeight())
                Row(modifier = GlanceModifier.fillMaxWidth(), verticalAlignment = Alignment.CenterVertically) {
                    WidgetActionButton(intent = searchIntent, icon = R.drawable.ic_widget_search,
                        contentDescription = searchFoodLabel, modifier = GlanceModifier.defaultWeight())
                    Spacer(modifier = GlanceModifier.width(8.dp))
                    WidgetActionButton(intent = scanIntent, icon = R.drawable.ic_widget_scan,
                        contentDescription = scanBarcodeLabel, modifier = GlanceModifier.defaultWeight())
                }
            }
        }
    }

    private data class CalorieSnapshot(
        val date: String,
        val remaining: Double,
        val goal: Double,
        val progress: Double,
        val lastUpdated: Long,
    )

    private fun loadSnapshot(context: Context): CalorieSnapshot? {
        val prefs = context.getSharedPreferences(
            CalorieWidgetReceiver.PREFS_NAME,
            Context.MODE_PRIVATE,
        )
        return parseSnapshot(prefs.getString(CalorieWidgetReceiver.PREFS_KEY_SNAPSHOT, null))
    }

    private fun parseSnapshot(json: String?): CalorieSnapshot? {
        if (json == null) return null
        return try {
            val obj = JSONObject(json)
            val date = obj.optString("date", "")
            if (!isToday(date)) return null
            CalorieSnapshot(
                date = date,
                remaining = obj.optDouble("remaining", 0.0),
                goal = obj.optDouble("goal", 0.0),
                progress = obj.optDouble("progress", 0.0),
                lastUpdated = obj.optLong("lastUpdated", 0L),
            )
        } catch (e: Exception) {
            null
        }
    }

    private fun isToday(date: String): Boolean {
        if (date.isBlank()) return false
        return try {
            val parsed = LocalDate.parse(date, DateTimeFormatter.ISO_LOCAL_DATE)
            parsed == LocalDate.now()
        } catch (e: Exception) {
            false
        }
    }

    private fun formatInt(context: Context, value: Double): String {
        // Pre-localization rounding preserved: the calorie widget truncates
        // (1240.7 -> 1240) — see 22415819.
        return formatWidgetInt(context, value.toLong())
    }

    companion object {
        val SNAPSHOT_STATE_KEY = stringPreferencesKey(CalorieWidgetReceiver.PREFS_KEY_SNAPSHOT)
    }
}

fun GlanceModifier.appWidgetBackgroundCornerRadius(): GlanceModifier {
    return if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
        cornerRadius(android.R.dimen.system_app_widget_background_radius)
    } else {
        cornerRadius(16.dp)
    }
}
