# Use an official Node.js runtime as a parent image
FROM node:24-alpine

RUN corepack enable

WORKDIR /app

RUN apk add --no-cache curl postgresql18-client tar gzip
# Copy workspace root files for pnpm resolution
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Copy all workspace member package.json files for dependency graph resolution
COPY XoTServer/package.json XoTServer/
COPY XoTFrontend/package.json XoTFrontend/
COPY XoTMobile/package.json XoTMobile/
COPY shared/package.json shared/

# Copy patch files referenced by pnpm.patchedDependencies in root package.json
COPY patches/ patches/

# Install workspace dependencies
RUN pnpm install --filter xot-server...

COPY shared/ shared/
COPY XoTServer/ XoTServer/
# Set working directory to server for runtime
WORKDIR /app/XoTServer

# The container will be run using the command from docker-compose, so no CMD is needed here.
