  "components": [
    {
      "name": "Mobile settings group",
      "kind": "card",
      "refersTo": "mobile-settings-group",
      "description": "Shared rounded surface and thin divider for related mobile settings.",
      "html": "<div class=\"ds-mobile-group\"><div class=\"ds-mobile-group-row\">Server</div><div class=\"ds-mobile-group-divider\"></div><div class=\"ds-mobile-group-row\">Health Data Sync</div></div>",
      "css": ".ds-mobile-group{background:#f0eadd;border-radius:12px;overflow:hidden;box-shadow:var(--shadow-sm,0 1px 2px rgba(0,0,0,.05));color:#171c22}.ds-mobile-group-row{padding:16px;font-size:16px;font-weight:600}.ds-mobile-group-divider{height:1px;background:hsl(213 16% 90%)}"
    },
    {
      "name": "Mobile status row",
      "kind": "custom",
      "refersTo": "mobile-settings-row",
      "description": "Action row with a text status, destination cue, and semantic status dot.",
      "html": "<button class=\"ds-mobile-status\"><span class=\"ds-mobile-status-icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"8\" rx=\"2\"/><rect x=\"3\" y=\"13\" width=\"18\" height=\"8\" rx=\"2\"/></svg></span><span class=\"ds-mobile-status-copy\"><strong>Server</strong><small><i aria-hidden=\"true\"></i>Connected</small></span><span class=\"ds-mobile-status-chevron\" aria-hidden=\"true\">\u203a</span></button>",
      "css": ".ds-mobile-status{display:flex;align-items:center;width:100%;padding:16px;border:0;background:#f0eadd;color:#171c22;text-align:left;cursor:pointer}.ds-mobile-status:hover,.ds-mobile-status:active{opacity:.7}.ds-mobile-status:focus-visible{outline:2px solid #0b5e46;outline-offset:-2px}.ds-mobile-status-icon{width:40px;height:40px;display:grid;place-items:center;margin-right:12px;border-radius:8px;background:#fff;color:#0b5e46}.ds-mobile-status-copy{flex:1;display:grid;gap:2px}.ds-mobile-status-copy strong{font-size:16px;font-weight:600}.ds-mobile-status-copy small{font-size:14px;color:#40554c}.ds-mobile-status-copy i{display:inline-block;width:8px;height:8px;margin-right:8px;border-radius:50%;background:#0b5e46}.ds-mobile-status-chevron{font-size:22px;color:#40554c}"
    },
    {
      "name": "Web active profile card",
      "kind": "card",
      "refersTo": "web-profile-card",
      "description": "Compact account context in the Settings header.",
      "html": "<div class=\"ds-web-profile\"><small>Active profile</small><strong>Loading profile</strong><span>Your account</span></div>",
      "css": ".ds-web-profile{min-width:208px;padding:12px 16px;border-radius:12px;background:hsl(43 100% 99%);color:hsl(213 19% 11%);display:grid;gap:4px}.ds-web-profile small,.ds-web-profile span{font-size:12px;color:hsl(153 12% 36%)}.ds-web-profile strong{font-size:14px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}"
    },
    {
      "name": "Web section tab",
      "kind": "nav",
      "refersTo": "web-active-section-tab",
      "description": "Category navigation; selected state uses the accent surface and stronger type.",
      "html": "<div class=\"ds-web-tabs\" role=\"tablist\" aria-label=\"Settings sections\"><button class=\"ds-web-tab\" role=\"tab\" aria-selected=\"true\">Profile &amp; Account</button><button class=\"ds-web-tab\" role=\"tab\" aria-selected=\"false\">Nutrition &amp; Tracking</button></div>",
      "css": ".ds-web-tabs{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px}.ds-web-tab{min-height:48px;padding:8px 12px;border:0;border-radius:8px;background:transparent;color:hsl(153 12% 36%);text-align:left;font-size:14px;cursor:pointer}.ds-web-tab:hover{background:hsl(39 27% 89%);color:hsl(213 19% 11%)}.ds-web-tab:focus-visible{outline:2px solid hsl(163 79% 21%);outline-offset:2px}.ds-web-tab[aria-selected=true]{background:hsl(148 23% 87%);color:hsl(213 19% 11%);font-weight:600}@media(min-width:640px){.ds-web-tabs{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(min-width:1024px){.ds-web-tabs{display:flex;flex-direction:column;width:240px}}"
    },
    {
      "name": "Web settings accordion",
      "kind": "custom",
      "refersTo": "web-settings-accordion",
      "description": "Bordered expandable setting with a title, description, and clear focus.",
      "html": "<button class=\"ds-web-accordion\" aria-expanded=\"false\"><span><strong>Allergen Preferences</strong><small>Track allergens you want to be warned about in foods</small></span><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"/></svg></button>",
      "css": ".ds-web-accordion{width:100%;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:16px;border:1px solid hsl(40 22% 82%);border-radius:8px;background:transparent;color:hsl(213 19% 11%);text-align:left;cursor:pointer}.ds-web-accordion:hover{background:hsl(39 27% 89%)}.ds-web-accordion:focus-visible{outline:2px solid hsl(163 79% 21%);outline-offset:-2px}.ds-web-accordion span{display:grid;gap:4px}.ds-web-accordion strong{font-size:14px;font-weight:500}.ds-web-accordion small{font-size:14px;font-weight:400;color:hsl(153 12% 36%)}.ds-web-accordion svg{flex:none;transition:transform .2s}.ds-web-accordion[aria-expanded=true] svg{transform:rotate(180deg)}"
    },
    {
      "name": "Mobile Dashboard quick action",
      "kind": "button",
      "refersTo": "mobile-dashboard-quick-action",
      "description": "Native Food quick-action tile, translated into a static HTML preview; the real action opens food search for the selected date.",
      "html": "<button class=\"ds-dashboard-action\"><svg aria-hidden=\"true\" width=\"23\" height=\"23\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M5 3v5a3 3 0 0 0 6 0V3M8 3v18M18 3c-3 3-3 8 0 8h1M19 3v18\"/></svg><span>Food</span></button>",
      "css": ".ds-dashboard-action{min-height:64px;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:8px 4px;border:1px solid hsl(213 16% 90%);border-radius:16px;background:#fff;color:#171c22;cursor:pointer}.ds-dashboard-action svg{color:#0b5e46}.ds-dashboard-action span{margin-top:8px;font-size:12px;font-weight:600}.ds-dashboard-action:hover{border-color:#0b5e46}.ds-dashboard-action:active{opacity:.8}.ds-dashboard-action:focus-visible{outline:2px solid #0b5e46;outline-offset:2px}"
    },
    {
      "name": "Mobile Dashboard nutrient row",
      "kind": "custom",
      "refersTo": "mobile-dashboard-macro-row",
      "description": "Native nutrient row with inline label, rail, illustrative amount/goal, and percentage; native text scales above 1.3 stack the contents.",
      "html": "<div class=\"ds-dashboard-macro\" aria-label=\"Protein: 60 g / 100 g\"><strong>Protein</strong><div class=\"ds-dashboard-macro-track\"><div class=\"ds-dashboard-macro-fill\"></div></div><span class=\"ds-dashboard-macro-amount\">60 / 100 g</span><span class=\"ds-dashboard-macro-percent\">60%</span></div>",
      "css": ".ds-dashboard-macro{display:flex;align-items:center;gap:6px;min-height:28px;padding:4px 0;color:#171c22}.ds-dashboard-macro strong{width:32%;font-size:13px;font-weight:500}.ds-dashboard-macro span{font-size:12px;color:#40554c}.ds-dashboard-macro-track{flex:1;height:8px;border-radius:999px;overflow:hidden;background:hsl(218 29% 92%)}.ds-dashboard-macro-fill{width:60%;height:100%;border-radius:4px;background:#95590f}.ds-dashboard-macro-amount{width:78px;text-align:right}.ds-dashboard-macro-percent{width:34px;text-align:right}.ds-dashboard-macro[data-expanded=true]{flex-direction:column;align-items:stretch}.ds-dashboard-macro[data-expanded=true] strong,.ds-dashboard-macro[data-expanded=true] span{width:auto;text-align:left}.ds-dashboard-macro[data-expanded=true] .ds-dashboard-macro-track{flex:none}"
    },
