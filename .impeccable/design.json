      "html": "<div class=\"ds-dashboard-section\"><div class=\"ds-dashboard-section-header\"><div class=\"ds-dashboard-section-title\"><svg class=\"ds-dashboard-section-icon\" aria-hidden=\"true\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M12 3s-7 8-7 12a7 7 0 0 0 14 0c0-4-7-12-7-12Z\"/></svg><strong>Hydration</strong></div><button class=\"ds-dashboard-details\" aria-label=\"Hydration: Details\"><span>Details</span><svg aria-hidden=\"true\" width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"m9 6 6 6-6 6\"/></svg></button></div></div>",
