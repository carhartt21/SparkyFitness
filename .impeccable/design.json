      "css": ".ds-dashboard-overview{background:#f0eadd;color:#171c22;border:1px solid hsl(213 16% 90%);border-radius:16px;padding:12px}.ds-dashboard-overview-link{display:flex;align-items:center;justify-content:space-between;gap:12px;width:100%;min-height:44px;padding:0;margin-bottom:4px;border:0;background:transparent;color:inherit;text-align:left;cursor:pointer}.ds-dashboard-overview-link strong{font-size:16px;font-weight:600}.ds-dashboard-overview-link span{font-size:18px;color:#40554c}.ds-dashboard-overview-link:hover,.ds-dashboard-overview-link:active{opacity:.8}.ds-dashboard-overview-link:focus-visible{outline:2px solid #0b5e46;outline-offset:2px}.ds-dashboard-overview p{font-size:14px;color:#40554c;margin:0}.ds-dashboard-overview small{display:block;margin-top:12px;font-size:12px;color:#40554c}"
