      "html": "<div class=\"ds-dashboard-section\"><button class=\"ds-dashboard-details\" aria-label=\"Hydration: Details\"><svg class=\"ds-dashboard-section-icon\" aria-hidden=\"true\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M12 3s-7 8-7 12a7 7 0 0 0 14 0c0-4-7-12-7-12Z\"/></svg><span class=\"ds-dashboard-section-copy\"><strong>Hydration</strong><span>Details</span></span><svg aria-hidden=\"true\" width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"m9 6 6 6-6 6\"/></svg></button></div>",
      "css": ".ds-dashboard-section{padding:16px;background:#13272f;color:#edf5f7;border:1px solid #30474f;border-radius:16px}.ds-dashboard-details{display:flex;align-items:center;gap:8px;width:100%;min-height:44px;margin-bottom:8px;padding:0;border:0;background:transparent;color:#08d6ad;text-align:left;cursor:pointer}.ds-dashboard-section-icon{color:#39c9f1;flex:none}.ds-dashboard-section-copy{display:flex;flex:1;flex-direction:column}.ds-dashboard-section-copy strong{font-size:16px;font-weight:600;color:#edf5f7}.ds-dashboard-section-copy span{font-size:12px;font-weight:500}.ds-dashboard-details:hover,.ds-dashboard-details:active{opacity:.8}.ds-dashboard-details:focus-visible{outline:2px solid #08d6ad;outline-offset:2px}"
    }
